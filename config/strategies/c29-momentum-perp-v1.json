{
  "schema": "balancita-strategy.v1",
  "id": "c29-momentum-perp-v1",
  "version": 1,
  "name": "C29 Momentum logarítmico lento",
  "description": "Sigue movimientos extremos: entra cuando el retorno logarítmico de 6 h (72 velas de 5 m) supera 2,5 desviaciones de la volatilidad logarítmica diaria, y sale por stop de 2 sigmas diarias, objetivo o 24 h.",
  "params": {
    "z_min": "2.5",
    "sqrt_bars": "8.485281",
    "stop_atr": "2",
    "target_stop_ratio": "1.5"
  },
  "indicators": {
    "logret": [72],
    "logvol": [288]
  },
  "rules": {
    "gates": [
      {
        "require": "trend",
        "reason": "trend_features_unavailable",
        "condition": "trend_features_ready"
      }
    ],
    "checks": [
      {
        "name": "long",
        "node": {
          "all": [
            {
              "available": "log_volatility_available",
              "operand": "5m.logvol288"
            },
            {
              "cmp": "log_return_6h_above_z_sigma",
              "left": "5m.logret72",
              "op": ">",
              "right": {
                "mul": [
                  {
                    "mul": ["5m.logvol288", "$z_min"]
                  },
                  "$sqrt_bars"
                ]
              }
            }
          ]
        }
      },
      {
        "name": "short",
        "node": {
          "all": [
            {
              "available": "log_volatility_available",
              "operand": "5m.logvol288"
            },
            {
              "cmp": "log_return_6h_below_minus_z_sigma",
              "left": {
                "mul": ["5m.logret72", "-1"]
              },
              "op": ">",
              "right": {
                "mul": [
                  {
                    "mul": ["5m.logvol288", "$z_min"]
                  },
                  "$sqrt_bars"
                ]
              }
            }
          ]
        }
      }
    ],
    "sides": {
      "LONG": {
        "requires": ["long"],
        "reason": "c29_long_momentum",
        "invalidation": "stop_or_24h_time_stop"
      },
      "SHORT": {
        "requires": ["short"],
        "reason": "c29_short_momentum",
        "invalidation": "stop_or_24h_time_stop"
      }
    },
    "exit": {
      "LONG": {
        "cmp": "no_rule_exit_stop_target_or_24h",
        "left": "0",
        "op": ">",
        "right": "1"
      },
      "SHORT": {
        "cmp": "no_rule_exit_stop_target_or_24h",
        "left": "0",
        "op": ">",
        "right": "1"
      }
    },
    "risk": {
      "stop_atr": "$stop_atr",
      "target_stop_ratio": "$target_stop_ratio",
      "vol": "5m.logvol288",
      "vol_minutes": 5
    },
    "horizon_minutes": 1440
  }
}
