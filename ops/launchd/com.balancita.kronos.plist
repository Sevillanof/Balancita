<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Plantilla: reemplazar __WORKTREE__ (checkout con python/kronos_lab y .venv-kronos), __KRONOS_REPO__ y __DATA__. -->
<plist version="1.0">
<dict>
  <key>Label</key><string>com.balancita.kronos</string>
  <key>WorkingDirectory</key><string>__WORKTREE__</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>KRONOS_REPO</key><string>__KRONOS_REPO__</string>
    <key>PYTHONPATH</key><string>python</string>
  </dict>
  <key>ProgramArguments</key>
  <array>
    <string>__WORKTREE__/.venv-kronos/bin/python</string>
    <string>-m</string><string>kronos_lab.lab</string>
    <string>--out</string><string>__DATA__/kronos</string>
    <string>--mode</string><string>forward</string>
    <string>--loop-seconds</string><string>3600</string>
  </array>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>ThrottleInterval</key><integer>60</integer>
  <key>ProcessType</key><string>Background</string>
  <key>StandardOutPath</key><string>__DATA__/kronos/forward.log</string>
  <key>StandardErrorPath</key><string>__DATA__/kronos/forward.err.log</string>
</dict>
</plist>
