<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Plantilla: reemplazar __REPO__ y __DATA__ (ver docs/orderbook-collector.md). NO se instala sola. -->
<plist version="1.0">
<dict>
  <key>Label</key><string>com.balancita.book-collector</string>
  <key>WorkingDirectory</key><string>__REPO__/server</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/env</string><string>pnpm</string><string>book:collect</string>
    <string>--out</string><string>__DATA__/book/book.sqlite</string>
  </array>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key>
  <dict><key>SuccessfulExit</key><false/></dict>
  <key>ThrottleInterval</key><integer>30</integer>
  <key>ProcessType</key><string>Background</string>
  <key>Nice</key><integer>10</integer>
  <key>StandardOutPath</key><string>__DATA__/book/collector.log</string>
  <key>StandardErrorPath</key><string>__DATA__/book/collector.err.log</string>
</dict>
</plist>
