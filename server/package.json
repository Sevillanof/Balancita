{
  "name": "balancita-gemini-server",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Minimal Fastify gateway that keeps the Gemini API key out of the browser.",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json",
    "candles:backfill": "node --experimental-strip-types src/features/kraken-futures/official-candles-backfill-cli.ts",
    "funding:backfill": "node --experimental-strip-types src/features/kraken-futures/funding-backfill-cli.ts",
    "market:prune": "node --experimental-strip-types src/features/kraken-futures/futures-market-prune-cli.ts"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@google/genai": "^2.23.0",
    "fast-xml-parser": "^5.11.1",
    "fastify": "^5.12.5",
    "ws": "8.21.3"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/ws": "8.18.2",
    "typescript": "~6.0.2",
    "vitest": "^5.0.1"
  }
}
