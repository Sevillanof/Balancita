{
  "name": "balancita-gemini-server",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Minimal Fastify gateway that keeps the Gemini API key out of the browser.",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "node ../scripts/server.mjs dev",
    "start": "node ../scripts/server.mjs start",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json",
    "replay:run": "node --experimental-strip-types src/features/replay/replay-cli.ts",
    "simulations:run": "node --experimental-strip-types src/features/simulations/simulations-cli.ts"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@google/genai": "^2.23.0",
    "fast-xml-parser": "^5.11.1",
    "fastify": "^5.12.5"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "typescript": "~6.0.2",
    "vitest": "^5.0.1"
  }
}
