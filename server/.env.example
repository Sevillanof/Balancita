# Balancita Gemini gateway configuration.
# Copy this file to .env and fill in the values. Never commit a real key.

# Gemini API key (required only for /api/analyze calls; the server boots without it).
GEMINI_API_KEY=

# Model for structured analysis. Default is the free-tier flash-lite model.
GEMINI_MODEL=gemini-3.5-flash-lite

# Hard output cap for the model (tokens).
GEMINI_MAX_OUTPUT_TOKENS=1024

# Per-request timeout in milliseconds.
GEMINI_TIMEOUT_MS=15000

# Internal budget stays below the observed free-tier limits (verified 2026-09-20:
# 15 RPM / 500 RPD for this model in Google AI Studio).
GEMINI_MAX_REQUESTS_PER_MINUTE=10
GEMINI_MAX_REQUESTS_PER_DAY=300
GEMINI_CACHE_TTL_MS=300000

# Capacity of the in-memory response cache (keyed by hash of the analysis input).
GEMINI_CACHE_MAX_ENTRIES=100

# Cap on candle history forwarded to the model (oldest candles are dropped).
GEMINI_MAX_CANDLES=500

# HTTP binding for this gateway. Loopback only: the key must never leave this machine.
HOST=127.0.0.1
PORT=8787

# Origin allowed to call this gateway (the Vite dev server by default).
GEMINI_SERVER_CORS_ORIGIN=http://localhost:5173

# Kraken WebSocket trade collection, shadow runs, forecasts, and its intelligence
# stream state are disabled by default. REST OHLC polling is enabled by default.
# Only public Kraken endpoints are used: no API key is ever required.
# MARKET_COLLECTOR_ENABLED is a legacy fallback for either worker only when its
# independent flag is absent. Prefer the independent flags below.
MARKET_COLLECTOR_ENABLED=
# Kraken WebSocket trades, shadow/forecast collection, and intelligence stream state (default: false).
KRAKEN_WS_COLLECTOR_ENABLED=false
# Kraken REST OHLC worker and /api/market/collector/status enabled state (default: true).
KRAKEN_REST_OHLC_WORKER_ENABLED=true
PAPER_TRADING_ENABLED=true
# Polling interval for the Kraken REST OHLC worker in milliseconds (default: 60000).
MARKET_COLLECTOR_INTERVAL_MS=60000
MARKET_DB_PATH=./data/market.sqlite
KRAKEN_WS_URL=wss://ws.kraken.com/v2
KRAKEN_REST_URL=https://api.kraken.com/0
MARKET_STALE_AFTER_MS=15000
MARKET_RECONNECT_MIN_MS=1000
MARKET_RECONNECT_MAX_MS=30000

# Live forecast loop. Disabled by default so tests and dev runs stay
# deterministic. When enabled (and the market collector is on), the loop turns
# fresh Kraken observations into closed 15m candles and persists shadow-live
# forecasts and their outcomes through the existing deterministic engine.
FORECAST_LOOP_ENABLED=false
FORECAST_LOOP_INTERVAL_MS=60000

# News pipeline. Official SEC/ECB/Fed RSS polling remains opt-in.
NEWS_POLLING_ENABLED=false
NEWS_POLL_INTERVAL_MS=300000
NEWS_STALE_AFTER_MS=900000
NEWS_USER_AGENT=Balancita/1.0

# requests are bounded to one poll every 60-120 seconds and only ask for BTC.

# Tree News is disabled unless explicitly enabled. No API key is required for
# this local public feed; advanced sources may require Tree credentials.
TREE_NEWS_ENABLED=false
TREE_NEWS_URL=wss://news.treeofalpha.com/ws
TREE_NEWS_RECONNECT_MIN_MS=1000
TREE_NEWS_RECONNECT_MAX_MS=30000

# Optional extra feeds. One or more comma-separated entries. Each entry is:
# sourceId|source label|public HTTPS RSS URL|unknown or licensed
# The Block publishes a public RSS feed (https://www.theblock.co/rss.xml),
# licensed coverage from an independent crypto newsroom. It is safe to enable.
# CoinNess exposes no public RSS today; its Live Feed API is a B2B partner
# offer, so supply its endpoint here only after you obtain permitted access.
# Unknown license status is surfaced in the SSE/UI.
NEWS_EXTRA_RSS_FEEDS=theblock|The Block|https://www.theblock.co/rss.xml|unknown
