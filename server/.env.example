# Balancita Gemini gateway configuration.
# Copy this file to .env and fill in the values. Never commit a real key.

# Gemini API key (required only for /api/analyze calls; the server boots without it).
GEMINI_API_KEY=

# Model for structured analysis. Default is the free-tier flash-lite model.
GEMINI_MODEL=gemini-3.5-flash-lite

# Hard output cap for the model (tokens).
GEMINI_MAX_OUTPUT_TOKENS=1024

# Per-request timeout in milliseconds.
GEMINI_TIMEOUT_MS=15000

# Internal budget stays below the observed free-tier limits (verified 2026-09-20:
# 15 RPM / 500 RPD for this model in Google AI Studio).
GEMINI_MAX_REQUESTS_PER_MINUTE=10
GEMINI_MAX_REQUESTS_PER_DAY=300
GEMINI_CACHE_TTL_MS=300000

# Capacity of the in-memory response cache (keyed by hash of the analysis input).
GEMINI_CACHE_MAX_ENTRIES=100

# Cap on candle history forwarded to the model (oldest candles are dropped).
GEMINI_MAX_CANDLES=500

# HTTP binding for this gateway. Loopback only: the key must never leave this machine.
HOST=127.0.0.1
PORT=8787

# Origin allowed to call this gateway (the Vite dev server by default).
GEMINI_SERVER_CORS_ORIGIN=http://localhost:5173

# Durable Coinbase market ingestion is disabled by default for tests and local
# development. Enable it only for an intentional local read-only session.
MARKET_COLLECTOR_ENABLED=false
MARKET_DB_PATH=./data/market.sqlite
COINBASE_WS_URL=wss://ws-feed.exchange.coinbase.com
MARKET_STALE_AFTER_MS=15000
MARKET_RECONNECT_MIN_MS=1000
MARKET_RECONNECT_MAX_MS=30000
