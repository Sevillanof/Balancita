# Capture and gateway configuration (public Kraken Futures data only: no key needed).
# Copy this file to .env to override a default.

# HTTP binding of the read-only gateway. Loopback only.
HOST=127.0.0.1
PORT=8787

# Origin allowed to call the gateway (the Vite dev server by default).
CORS_ORIGIN=http://localhost:5173

FUTURES_MARKET_DB_PATH=./data/futures-market.sqlite
MARKET_STALE_AFTER_MS=15000
MARKET_RECONNECT_MIN_MS=1000
MARKET_RECONNECT_MAX_MS=30000
